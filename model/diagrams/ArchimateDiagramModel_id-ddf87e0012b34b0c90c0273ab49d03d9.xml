  <children
      xsi:type="archimate:DiagramModelNote"
      id="id-332df9fad3b041d8bb8f25ce7294877d"
      font="1|Lucida Grande|18.0|0|COCOA|1|LucidaGrande"
      textAlignment="1"
      content="P0 – Baseline: IT Management, Data processing -> Foundation&#xA;P1 – Event Ready: Registration &amp; tracking, Access control, Floor planning -> UC1&#xA;P2 – Engagement: ActiveVisitor analytics, Event marketing -> UC1 + UC2&#xA;P3 – Post-event: Visitor feedback &amp; retention, personalized marketing -> UC2 + UC3&#xA;&#xA;How can we increase visitor engagement during the event while improving the visitor experience?&#xA;How can we increase the probability that visitors attend future events?&#xA;How can we increase perceived value after the event? I need to make a roadmap in archi mate, how would you make it ?">
    <bounds
        x="264"
        y="996"
        width="753"
        height="265"/>
  </children>
